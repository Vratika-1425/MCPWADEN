{
  "name": "mcpwarden",
  "version": "1.0.0",
  "description": "MCPWarden: runtime security proxy for Web MCP tools (demo page + live backend)",
  "main": "server/index.js",
  "scripts": {
    "build": "sh build.sh",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "test": "npm run build && npm run test:demo && npm run test:integration",
    "test:demo": "node tests/run-demo-suites.js",
    "test:integration": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "demo:campus": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/campus-demo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "express": "4.22.3",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "jsdom": "24.1.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
